{
  "name": "approval-hero",
  "version": "1.0.0",
  "private": true,
  "description": "Approval Hero — vehicle financing website, CMS API, and admin portal",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "next dev",
    "dev:api": "tsx watch server/src/server.ts",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p server/tsconfig.json",
    "build:web": "next build",
    "start": "concurrently -n web,api -c blue,green \"npm run start:web\" \"npm run start:api\"",
    "start:web": "next start",
    "start:api": "node server/dist/server.js",
    "deploy:check": "node scripts/check-deploy.mjs",
    "deploy:secrets": "node scripts/generate-secrets.mjs",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "seed": "tsx server/src/scripts/seed.ts",
    "create-admin": "tsx server/src/scripts/createAdmin.ts",
    "sync-pages": "tsx server/src/scripts/syncPageSections.ts",
    "lint": "next lint"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@studio-freight/lenis": "^1.0.42",
    "@tanstack/react-query": "^5.102.5",
    "@tiptap/extension-image": "^3.30.5",
    "@tiptap/extension-link": "^3.30.5",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "axios": "^1.20.0",
    "bcrypt": "^5.1.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "framer-motion": "^13.1.1",
    "gsap": "^3.15.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.34.0",
    "mongoose": "^8.9.3",
    "multer": "^1.4.5-lts.1",
    "next": "14.2.35",
    "nodemailer": "^6.9.16",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.86.0",
    "sanitize-html": "^2.14.0",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.6.0",
    "winston": "^3.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/sanitize-html": "^2.13.0",
    "concurrently": "^9.1.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}

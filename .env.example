# ─── Server (Express API) ───
NODE_ENV=development
PORT=5000
WEB_PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/approval_hero
JWT_SECRET=change-this-to-a-long-random-secret-in-production
ENCRYPTION_KEY=change-this-to-a-32-byte-secret-for-pii-encryption
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Approval Hero <noreply@approvalhero.ca>
NOTIFICATION_EMAIL=notifications@yourdomain.com
MAX_UPLOAD_SIZE_MB=8
UPLOAD_DIR=server/uploads
ADMIN_EMAIL=admin@approvalhero.ca
ADMIN_PASSWORD=ChangeMe123!

# SMS verification (Twilio Verify) — required in production
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ─── Next.js (public site + admin) ───
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_UPLOADS_URL=http://localhost:5000

# Optional: proxy /api through Next.js (same-origin, single public port)
# INTERNAL_API_URL=http://127.0.0.1:5000

# ─── Production example (uncomment and edit) ───
# NODE_ENV=production
# FRONTEND_URL=https://yourdomain.com
# COOKIE_SECURE=true
# NEXT_PUBLIC_API_URL=https://yourdomain.com/api
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
# NEXT_PUBLIC_UPLOADS_URL=https://yourdomain.com
# INTERNAL_API_URL=http://127.0.0.1:5000